{
  "name": "open-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/studio.mjs --dev",
    "build": "vite build",
    "start": "node server/studio.mjs",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test"
  },
  "dependencies": {
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@lezer/highlight": "1.2.5",
    "@uiw/codemirror-theme-vscode": "4.25.12",
    "codemirror": "6.0.2",
    "lucide-react": "1.70.0",
    "mysql2": "3.24.6",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "build": {
    "appId": "com.openstudio.desktop",
    "productName": "Open Studio",
    "artifactName": "Open-Studio-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "server/**"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.7"
  }
}
